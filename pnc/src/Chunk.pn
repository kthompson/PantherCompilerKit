using panther

[derive(Eq, Show)]
class Chunk() {
  // TODO: we don't currently support byte types so we will implement this with ints

  // line number for each instruction
  var lines = new IntList()
  // the actual instructions
  var content = new IntList()
  var size = 0

  def ensureSpace(n: int): unit = {
    content.ensureSpace(n)
    lines.ensureSpace(n)
  }

  def emitOpcode(opcode: int, line: int): unit = {
    emitI4(opcode, line)
  }

  def emitI4(value: int, line: int): unit = {
    ensureSpace(1)
    content.add(value)
    lines.add(line)
    size = size + 1
  }

  def readI4(offset: int): int = {
    checkBounds(offset)
    content.read(offset)
  }

  def readLine(offset: int): int = {
    checkBounds(offset)
    lines.read(offset)
  }

  def patch(offset: int, value: int): unit = {
    checkBounds(offset)
    content.update(offset, value)
  }

  /** The instructions and the line each came from.
    *
    * Lines are not needed to execute, but they are what a trace and a runtime
    * error report, so an image without them would run and describe itself
    * wrongly.
    */
  def write(buffer: IntList): unit = {
    buffer.add(size)
    for (i <- 0 to (size - 1)) {
      buffer.add(content.read(i))
    }
    for (i <- 0 to (size - 1)) {
      buffer.add(lines.read(i))
    }
  }

  def read(buffer: IntList, offset: int): int = {
    val count = buffer.read(offset)
    size = 0
    content.size = 0
    lines.size = 0

    for (i <- 0 to (count - 1)) {
      content.add(buffer.read(offset + 1 + i))
    }
    for (i <- 0 to (count - 1)) {
      lines.add(buffer.read(offset + 1 + count + i))
    }
    size = count

    offset + 1 + count + count
  }

  def checkBounds(offset: int): unit = {
    // Keep formatting off the interpreter's hot path. Function arguments are
    // eager, so passing this message to assert converted the instruction
    // pointer to a string for every bytecode read, including valid ones.
    if (offset < 0 || offset >= size) {
      panic("Invalid offset " + string(offset))
    } else ()
  }
}
